# Valores de ejemplo para desarrollo local con Docker Compose.
# Copialo a .env; nunca subas el .env ni pongas claves reales aquí.

APP_NAME="Vení Roldanillo"
APP_ENV=local
# Se genera antes de `up` con: docker compose run --rm app php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Octane sobre FrankenPHP
OCTANE_SERVER=frankenphp

# PostgreSQL + PostGIS (servicio db del compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=veni
DB_USERNAME=veni
DB_PASSWORD=clave-de-ejemplo-solo-local
# Puerto publicado en 127.0.0.1 (5433 para no chocar con un PostgreSQL local)
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Meilisearch (servicio meilisearch del compose)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Clave maestra de ejemplo (mínimo 16 bytes); en producción, una aleatoria y secreta
MEILISEARCH_KEY=clave-maestra-de-ejemplo-solo-local
MEILI_ENV=development
FORWARD_MEILISEARCH_PORT=7700

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Mapa de veni-mapa (ADR 0007). Ejemplo: la demo publicada (hoy v0.2.0).
# En producción, una release fija: https://tiles.veniroldanillo.co/vX.Y.Z/veni-claro-es.json
VITE_MAP_STYLE_URL=https://wokerjj.github.io/veni-mapa/style/veni-claro-es.json
VITE_MAP_ROUTES_URL=https://wokerjj.github.io/veni-mapa/roldanillo-rutas.json
