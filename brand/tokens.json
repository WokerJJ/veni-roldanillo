{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "ciruela": { "$value": "#2A1638", "$description": "Texto principal, fondos oscuros, marca" },
    "arrebol": { "$value": "#F0525A", "$description": "Acento principal (ala del logo). No usar para texto pequeño sobre blanco" },
    "mango":   { "$value": "#F7A93B", "$description": "Estrellas, destacados, ala sobre fondo oscuro" },
    "lila":    { "$value": "#F3ECF6", "$description": "Superficies y fondos suaves" },
    "blanco":  { "$value": "#FFFFFF", "$description": "Fondo base" },
    "ciruela-suave": { "$value": "#6A5578", "$description": "Texto secundario (cumple 4.5:1 sobre blanco)" }
  },
  "font": {
    "display": { "$value": "'Bricolage Grotesque', system-ui, sans-serif", "$description": "Logo y títulos. Peso 700-800" },
    "body":    { "$value": "'Figtree', system-ui, sans-serif", "$description": "Textos e interfaz. Peso 400-700" }
  },
  "radius": { "sm": { "$value": "10px" }, "md": { "$value": "14px" }, "lg": { "$value": "22px" }, "pill": { "$value": "999px" } },
  "size": { "touch-min": { "$value": "44px", "$description": "Área táctil mínima" } }
}
