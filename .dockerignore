# Archivos y carpetas ocultos (git, editores, herramientas locales),
# salvo los que usa la compilación
.*
!.npmrc
!.env.example

# Documentación
docs
brand
# La compilación de Vite usa los tokens y los logos de la marca, y copia los
# íconos de la app instalable (#5); Laravel lee los colores de tokens.json
!brand/tokens.css
!brand/tokens.json
!brand/logo
!brand/png/veni-icono-192.png
!brand/png/veni-icono-512.png
!brand/png/veni-icono-maskable-512.png
!brand/png/favicon-180.png
*.md

# Dependencias y compilados (se instalan dentro de la imagen)
vendor
node_modules
public/build
# Service worker de la PWA: sale de la compilación dentro de la imagen; uno
# compilado en este equipo no debe entrar con el código
public/sw.js
public/hot
public/storage
public/frankenphp-worker.php

# Secretos: nunca dentro de la imagen (el .env ya queda fuera con .*)
auth.json

# Estado local
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/pail
# Peticiones que graba Inertia DevTools en local (props y cabeceras)
storage/inertia-devtools
bootstrap/cache/*.php
.phpunit.cache
.phpunit.result.cache
coverage

# Docker
Dockerfile
docker-compose*.yml

# Pruebas (no van en la imagen de producción)
tests
phpunit.xml

# Releases (el manifiesto ya queda fuera con .*)
release-please-config.json
