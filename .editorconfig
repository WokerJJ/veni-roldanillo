root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_size = 4

# Frontend: 4 espacios, igual que ESLint (vue/html-indent).
[*.{ts,vue,js,css,json}]
indent_size = 4

# Lo reescribe release-please en cada release, siempre con 2 espacios.
[.release-please-manifest.json]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
