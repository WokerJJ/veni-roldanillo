# Valores de ejemplo para desarrollo local con Docker Compose.
# Copialo a .env; nunca subas el .env ni pongas claves reales aquí.

APP_NAME="Vení Roldanillo"
APP_ENV=local
# Se genera antes de `up` con: docker compose run --rm app php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_TIMEZONE=America/Bogota
# Solo en el servidor: la versión publicada que corre (docs/despliegue.md). La
# escribe cada despliegue. Sin ella, docker-compose.yml usa la imagen que
# construye `docker compose build`.
# APP_IMAGE=ghcr.io/wokerjj/veni-roldanillo:X.Y.Z

# Proxies de los que se aceptan las cabeceras X-Forwarded-* (ADR 0014): IP o
# rangos CIDR separados por comas. Sin valor no se confía en nadie, que es lo
# correcto en desarrollo (no hay proxy delante). En el servidor, el proxy que
# termina TLS (docs/despliegue.md); nunca `*`.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Octane sobre FrankenPHP
OCTANE_SERVER=frankenphp

# Inertia: sin renderizado en el servidor (SSR) por ahora; Vue pinta en el navegador.
# Sin esta variable config/inertia.php del paquete lo deja activado por defecto.
INERTIA_SSR_ENABLED=false

# Inertia DevTools graba cada petición (props y cabeceras) en storage/inertia-devtools.
# Sin valor solo se activa con APP_ENV=local; en producción va en false
# (la imagen prod del Dockerfile ya lo fija).
# INERTIA_DEVTOOLS_ENABLED=false

# PostgreSQL + PostGIS (servicio db del compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=veni
DB_USERNAME=veni
DB_PASSWORD=clave-de-ejemplo-solo-local
# Puerto publicado en 127.0.0.1 (5433 para no chocar con un PostgreSQL local)
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Las cookies no se mandan desde otro sitio salvo al navegar hasta aquí.
SESSION_SAME_SITE=lax
# Cookies solo por HTTPS: la imagen de producción ya lo fija en true y el .env
# no lo cambia (ADR 0014). En desarrollo (http://localhost) va sin definir.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Meilisearch (servicio meilisearch del compose)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Clave maestra de ejemplo (mínimo 16 bytes); en producción, una aleatoria y secreta
MEILISEARCH_KEY=clave-maestra-de-ejemplo-solo-local
MEILI_ENV=development
FORWARD_MEILISEARCH_PORT=7700

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Mapa de veni-mapa (ADR 0007). El estilo es una plantilla: la app cambia
# {theme} por claro u oscuro y {locale} por es o en, según el tema y el idioma
# de la interfaz (estilos publicados: veni-{claro,oscuro}-{es,en}.json).
# Si tu .env es anterior a los marcadores y trae una URL fija
# (…/veni-claro-es.json), cambiala por la plantilla: sin {theme} y {locale}
# `npm run build` se detiene y `npm run dev` avisa, porque el mapa no seguiría
# al tema ni al idioma.
# Aquí, la demo pública de veni-mapa: sigue su rama main, NO es una versión
# fija (el ADR 0007 la tolera mientras no haya hosting versionado). En
# producción va una release fija (docs/despliegue.md):
#   https://tiles.veniroldanillo.co/vX.Y.Z/veni-{theme}-{locale}.json
# Vite las escribe en el JavaScript al compilar: cambiarlas exige compilar de
# nuevo (npm run build; en la imagen de producción son argumentos de build).
# Laravel lee además la del estilo (config/services.php) para que la vista raíz
# adelante la conexión con ese host (preconnect).
VITE_MAP_STYLE_URL=https://wokerjj.github.io/veni-mapa/style/veni-{theme}-{locale}.json
VITE_MAP_ROUTES_URL=https://wokerjj.github.io/veni-mapa/roldanillo-rutas.json
