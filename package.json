{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "icons:sync": "node scripts/icons-sync.mjs",
        "icons:check": "node scripts/icons-sync.mjs --check",
        "icons:verify": "node scripts/icons-sync.mjs --verify"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.3",
        "laravel-vite-plugin": "^3.2",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.1.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "maplibre-gl": "^6.16.0",
        "pmtiles": "^4.5.0",
        "vue": "^3.5.45"
    }
}
