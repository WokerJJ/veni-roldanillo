{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "icons:sync": "node scripts/icons-sync.mjs",
        "icons:check": "node scripts/icons-sync.mjs --check",
        "icons:verify": "node scripts/icons-sync.mjs --verify"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "vue": "^3.5.43"
    }
}
